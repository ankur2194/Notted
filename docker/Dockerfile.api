# syntax=docker/dockerfile:1.18
#
# Production image for the Notted API (NestJS). BullMQ workers run inside this
# same process, so there is no separate worker image.
#
# Targets:
#   runtime  (default) — `node dist/main.js`, non-root, Chromium for PDF export.
#   migrate            — the build stage with drizzle-kit; `compose.prod.yaml`
#                        runs it once per deploy before `api` starts.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.api -t notted-api:local .
ARG NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

# ------------------------------------------------------------------ build
FROM ${NODE_IMAGE} AS build
ARG PNPM_VERSION=10.34.5
ENV PNPM_HOME=/root/.local/share/pnpm
ENV COREPACK_HOME=/root/.cache/node/corepack
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV TURBO_TELEMETRY_DISABLED=1 NEXT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 HUSKY=0
ENV PATH="${PNPM_HOME}:${PATH}"
RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable pnpm \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /workspace
# Manifests first so the dependency layer is cached across source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/shared-validators/package.json packages/shared-validators/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @notted/api...

COPY tsconfig.base.json tsconfig.json ./
COPY packages/shared-types packages/shared-types
COPY packages/shared-validators packages/shared-validators
COPY apps/api apps/api
RUN pnpm --filter @notted/shared-types --filter @notted/shared-validators build \
    && pnpm --filter @notted/api build \
    # Production-only dependency tree with workspace packages copied in, not
    # symlinked, so the runtime stage can take a single self-contained directory.
    && pnpm --filter @notted/api deploy --legacy --prod /out

# ---------------------------------------------------------------- migrate
# Runs `drizzle-kit migrate` against DATABASE_URL. drizzle-kit is a dev
# dependency, so this stays on the build stage rather than bloating `runtime`.
FROM build AS migrate
WORKDIR /workspace/apps/api
USER node
CMD ["node", "./node_modules/drizzle-kit/bin.cjs", "migrate"]

# ---------------------------------------------------------------- runtime
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
ENV EXPORT_CHROMIUM_PATH=/usr/bin/chromium
# Chromium + fonts for PDF export (puppeteer-core). `sharp` ships its own
# prebuilt libvips, so nothing extra is needed for image processing. The bundled
# npm is removed for the same reason as in Dockerfile.dev: never invoked, and
# the largest source of advisories in the base image.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates chromium fonts-liberation fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

WORKDIR /app
COPY --from=build --chown=node:node /out/package.json ./
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /out/dist ./dist

USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD node -e 'fetch("http://127.0.0.1:"+(process.env.API_PORT||3001)+"/health/ready").then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))'
CMD ["node", "dist/main.js"]
