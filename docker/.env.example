# ---- PostgreSQL (pgvector) ----
POSTGRES_USER=notted
POSTGRES_PASSWORD=notted_dev_password
POSTGRES_DB=notted_dev

# App database connection (host apps use this; matches POSTGRES_* above for dev)
DATABASE_URL=postgres://notted:notted_dev_password@127.0.0.1:5432/notted_dev

# ---- Redis 7 (dev: no password) ----
# (no REDIS_PASSWORD in dev)

# ---- Meilisearch v1.x ----
# IMPORTANT: master key MUST be >= 16 bytes when set (Meilisearch v1.3+).
MEILI_MASTER_KEY=notted-dev-meili-master-key
MEILI_ENV=development

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=nottedminio
MINIO_ROOT_PASSWORD=notted-dev-minio-secret
MINIO_BUCKET_ATTACHMENTS=notted-attachments
MINIO_BUCKET_EXPORTS=notted-exports

# ---- Host-published ports (override if a port is already in use) ----
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILISEARCH_PORT=7700
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
