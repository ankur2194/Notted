ARG CADDY_IMAGE=caddy:2.11.4-alpine@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e
FROM ${CADDY_IMAGE}

# The upstream binary carries cap_net_bind_service for ports 80/443. This
# gateway listens on 8080, so remove the unused file capability before Compose
# drops every runtime capability; otherwise Linux refuses to exec the binary.
USER root
RUN setcap -r /usr/bin/caddy && test -z "$(getcap /usr/bin/caddy)"
USER 1000:1000
