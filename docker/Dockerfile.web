# syntax=docker/dockerfile:1.18
#
# Production image for the Notted web app (Next.js). NEXT_PUBLIC_* values are
# embedded into the client bundle by `next build`, so they are build arguments
# here, not runtime environment — rebuild the image to change a domain.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_APP_URL=https://app.example.com \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com \
#     --build-arg NEXT_PUBLIC_WS_URL=wss://api.example.com \
#     -t notted-web:local .
ARG NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

# ------------------------------------------------------------------ build
FROM ${NODE_IMAGE} AS build
ARG PNPM_VERSION=10.34.5
ENV PNPM_HOME=/root/.local/share/pnpm
ENV COREPACK_HOME=/root/.cache/node/corepack
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV TURBO_TELEMETRY_DISABLED=1 NEXT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 HUSKY=0
ENV PATH="${PNPM_HOME}:${PATH}"
RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable pnpm \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/shared-validators/package.json packages/shared-validators/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @notted/web...

COPY tsconfig.base.json tsconfig.json ./
COPY packages/shared-types packages/shared-types
COPY packages/shared-validators packages/shared-validators
COPY apps/web apps/web

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
ENV NODE_ENV=production
# `pnpm build` in apps/web runs `env:validate --production` first, which rejects
# a missing or non-HTTPS public URL before `next build` starts.
RUN pnpm --filter @notted/shared-types --filter @notted/shared-validators build \
    && pnpm --filter @notted/web build \
    && pnpm --filter @notted/web deploy --legacy --prod /out

# ---------------------------------------------------------------- runtime
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

WORKDIR /app
COPY --from=build --chown=node:node /out/package.json /out/next.config.js /out/security-headers.js ./
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /out/public ./public
COPY --from=build --chown=node:node /out/.next ./.next

USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD node -e 'fetch("http://127.0.0.1:3000").then((r)=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))'
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
