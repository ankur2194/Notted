{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    ".npmrc",
    "turbo.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".prettierignore"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_APP_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_WS_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "scripts/**/*",
        ".env.example",
        ".env.local",
        ".env.production",
        "tsconfig*.json",
        "package.json",
        "next.config.{js,ts,mjs,cjs}",
        "public/**/*"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "scripts/**/*", "tsconfig*.json", "package.json"],
      // `tsconfig.base.json` sets `composite: true`, so every package's
      // `tsc --noEmit -p tsconfig.json` writes a `.tsbuildinfo` even though it
      // emits nothing else. Without declaring it, a cache HIT skipped the run
      // and restored no incremental state, so the next real invocation had no
      // prior build-info to diff against and did a cold, full check — the exact
      // work `composite` exists to avoid.
      //
      // The paths are the measured ones, not a `**/*.tsbuildinfo` glob. That
      // glob would also match `tsconfig.build.tsbuildinfo`, which belongs to
      // `build`: a type-check cache hit in a fresh clone would then restore
      // build state with no matching `dist/*.js` beside it, and a later `build`
      // could believe it was up to date. `apps/api` writes into `dist/` because
      // its `tsconfig.json` sets `outDir`; the other three write at the package
      // root.
      "outputs": ["tsconfig.tsbuildinfo", "dist/tsconfig.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Turbo filters the environment strictly, so a variable that is not declared
      // here never reaches vitest. Every one of these is read by a suite (or by
      // the config parser a suite boots) and gates whether that suite runs:
      // `DATABASE_URL` for the ~30 `describe.skipIf` integration suites,
      // `MINIO_*` for `minio-test-helpers.ts`, `MEILISEARCH_*` for the search
      // and reindex suites, `MAILPIT_*` and `APP_ORIGIN` for the realtime and
      // email suites, `AUTH_E2E`/`AUTH_LOCKOUT_ATTEMPTS`/
      // `SESSION_REMEMBER_ME_DAYS`/`RATE_LIMIT_*` for the auth suites,
      // `EXPORT_CHROMIUM_PATH` for the PDF suite, `REALTIME_INTEGRATION` for the
      // socket suite, `FEATURE_*` for the feature gates, and `REDIS_URL` /
      // `BETTER_AUTH_*` / `DATA_ENCRYPTION_KEYS` for `createApplication()` in
      // `app.e2e.test.ts`. Undeclared, they all skip silently while the run
      // still prints green — the exact failure `test/integration-gates.test.ts`
      // now turns into one red test under CI.
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "APP_URL",
        "APP_ORIGIN",
        "AUTH_E2E",
        "AUTH_LOCKOUT_ATTEMPTS",
        "SESSION_REMEMBER_ME_DAYS",
        "REALTIME_INTEGRATION",
        "EXPORT_CHROMIUM_PATH",
        "DATA_ENCRYPTION_KEYS",
        "MINIO_*",
        "MEILISEARCH_*",
        "MAILPIT_*",
        "BETTER_AUTH_*",
        "RATE_LIMIT_*",
        "FEATURE_*"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "test/**/*",
        "tsconfig*.json",
        "vitest.config.ts",
        "package.json"
      ]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      // Same list as `test`, for the same reason, plus one that is specific to
      // coverage: a skipped suite still counts its source file as uncovered, so
      // an undeclared variable does not merely hide a suite — it drags branch
      // coverage far below the thresholds and reads as a real regression.
      // Declaring these also makes them part of the cache key, which is
      // correct: the same sources produce different coverage with and without
      // the infrastructure behind them.
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "APP_URL",
        "APP_ORIGIN",
        "AUTH_E2E",
        "AUTH_LOCKOUT_ATTEMPTS",
        "SESSION_REMEMBER_ME_DAYS",
        "REALTIME_INTEGRATION",
        "EXPORT_CHROMIUM_PATH",
        "DATA_ENCRYPTION_KEYS",
        "MINIO_*",
        "MEILISEARCH_*",
        "MAILPIT_*",
        "BETTER_AUTH_*",
        "RATE_LIMIT_*",
        "FEATURE_*"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "test/**/*",
        "tsconfig*.json",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "lint": {
      // API linting is TYPE-AWARE: `eslint.config.mjs` sets `projectService: true`
      // for `apps/api/**`, and `apps/api/tsconfig.json` uses `moduleResolution:
      // "Node10"`, so `@notted/shared-types` and `-validators` resolve through
      // their built `dist/index.d.ts`. Without this edge two things went wrong.
      // On a fresh clone (`pnpm install && pnpm lint`) that `dist/` does not
      // exist yet, so the `@darraghor/nestjs-typed` rules ran against unresolved
      // contract types and passed having checked less than they claim. And with
      // no upstream edge at all, editing `packages/shared-types/src` never
      // invalidated the cached lint result for `apps/api`.
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "scripts/**/*", "tsconfig*.json", "package.json"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "scripts/**/*", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
