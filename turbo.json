{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    ".npmrc",
    "turbo.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".prettierignore"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_APP_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_WS_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "scripts/**/*",
        ".env.example",
        ".env.local",
        ".env.production",
        "tsconfig*.json",
        "package.json",
        "next.config.{js,ts,mjs,cjs}",
        "public/**/*"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "scripts/**/*", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "test/**/*",
        "tsconfig*.json",
        "vitest.config.ts",
        "package.json"
      ]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*",
        "test/**/*",
        "tsconfig*.json",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "scripts/**/*", "tsconfig*.json", "package.json"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "src/**/*", "scripts/**/*", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
