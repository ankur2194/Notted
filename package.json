{
  "name": "notted",
  "version": "0.0.0",
  "private": true,
  "description": "Notted — corporate notes platform. pnpm + Turborepo monorepo root.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "env:init": "node scripts/dev-tooling.mjs env:init",
    "env:check": "node scripts/dev-tooling.mjs env:check",
    "infra:up": "node scripts/dev-tooling.mjs infra:up",
    "infra:up:ports": "node scripts/dev-tooling.mjs infra:up --with-service-ports",
    "infra:project": "node scripts/dev-tooling.mjs infra:project",
    "infra:down": "node scripts/dev-tooling.mjs infra:down",
    "infra:status": "node scripts/dev-tooling.mjs infra:status",
    "infra:logs": "node scripts/dev-tooling.mjs infra:logs",
    "infra:reset:dev": "node scripts/dev-tooling.mjs infra:reset:dev",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @notted/api dev",
    "dev:web": "pnpm --filter @notted/web dev",
    "build": "turbo run build",
    "build:packages": "pnpm --filter @notted/shared-types --filter @notted/shared-validators build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint && eslint eslint.config.mjs scripts --max-warnings 0",
    "lint:fix": "turbo run lint:fix && eslint eslint.config.mjs scripts --fix",
    "format": "turbo run format && prettier --write . --ignore-unknown",
    "format:check": "turbo run format:check && prettier --check . --ignore-unknown",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "test:ci": "turbo run test:ci && node --test scripts/*.test.mjs",
    "test:e2e": "node scripts/dev-tooling.mjs e2e:test",
    "test:api:dev-container": "docker compose -p notted-dev exec -T --workdir /workspace/apps/api api pnpm exec vitest run",
    "test:api:e2e-container": "docker compose -p notted-dev --profile e2e exec -T --workdir /workspace/apps/api api-e2e pnpm exec vitest run",
    "e2e:up": "node scripts/dev-tooling.mjs e2e:up",
    "e2e:test": "node scripts/dev-tooling.mjs e2e:test",
    "e2e:down": "node scripts/dev-tooling.mjs e2e:down",
    "audit:prod": "pnpm audit --prod",
    "security:deps": "pnpm audit --prod --audit-level=high",
    "security:containers": "node scripts/security-scan.mjs containers",
    "security:check": "pnpm security:deps && pnpm security:containers",
    "perf:bench": "node scripts/perf-bench.mjs",
    "db:check": "pnpm --filter @notted/api db:check",
    "db:migrate": "pnpm --filter @notted/api db:migrate",
    "db:generate": "pnpm --filter @notted/api db:generate",
    "db:studio": "pnpm --filter @notted/api db:studio",
    "db:seed": "node scripts/dev-tooling.mjs db:seed",
    "clean": "rimraf --glob \"**/dist\" \"**/.turbo\" \"**/coverage\" .turbo coverage && node scripts/ensure-docker-mounts.mjs",
    "clean:deps": "rimraf --glob \"**/node_modules\" node_modules && node scripts/ensure-docker-mounts.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "7.2.5",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.11",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.27",
    "class-validator": "0.14.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.1.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.6",
    "typescript-eslint": "8.65.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express@10.4.22>multer": "2.2.0",
      "next@16.2.11>postcss": "8.5.18",
      "next@16.2.11>sharp": "0.35.0",
      "body-parser@<1.20.6": "1.20.6",
      "esbuild@<0.25.0": "0.28.1",
      "file-type@<21.3.2": "21.3.4",
      "qs@<6.15.2": "6.15.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-36xv-jgw5-4q75",
        "GHSA-hq66-cqwq-w95j",
        "GHSA-mh99-v99m-4gvg",
        "GHSA-rgw5-rvv9-x895",
        "GHSA-2v37-7h3g-55p8"
      ]
    }
  }
}
