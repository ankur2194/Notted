{
  "name": "@notted/web",
  "version": "0.0.0",
  "private": true,
  "description": "Notted Next.js web application (scaffold — implemented in Part 4).",
  "scripts": {
    "dev": "pnpm env:validate && next dev",
    "build": "pnpm env:validate --production && next build",
    "start": "next start",
    "env:validate": "tsx scripts/validate-env.ts",
    "contracts:build": "pnpm --filter @notted/shared-types build && pnpm --filter @notted/shared-validators build",
    "pretype-check": "pnpm contracts:build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm contracts:build",
    "test": "vitest run",
    "pretest:ci": "pnpm contracts:build",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.24",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@notted/shared-types": "workspace:*",
    "@notted/shared-validators": "workspace:*",
    "@radix-ui/react-dialog": "1.1.21",
    "@radix-ui/react-slot": "1.3.1",
    "@tanstack/react-query": "5.101.4",
    "@tiptap/core": "2.27.1",
    "@tiptap/extension-color": "2.27.1",
    "@tiptap/extension-highlight": "2.27.1",
    "@tiptap/extension-link": "2.27.1",
    "@tiptap/extension-subscript": "2.27.1",
    "@tiptap/extension-superscript": "2.27.1",
    "@tiptap/extension-task-item": "2.27.1",
    "@tiptap/extension-task-list": "2.27.1",
    "@tiptap/extension-text-align": "2.27.1",
    "@tiptap/extension-text-style": "2.27.1",
    "@tiptap/extension-underline": "2.27.1",
    "@tiptap/pm": "2.27.1",
    "@tiptap/react": "2.27.1",
    "@tiptap/starter-kit": "2.27.1",
    "better-auth": "1.6.24",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.453.0",
    "next": "16.2.11",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@next/env": "16.2.11",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.20.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.22",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
