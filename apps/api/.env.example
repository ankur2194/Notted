# Notted API development environment for HOST-SIDE tooling.
#
# The Docker stack does not read this file: `compose.yaml` configures the api
# container directly and points it at the Compose service names. This file
# exists for commands run on the host — `pnpm db:studio`, `pnpm db:generate`,
# `pnpm test:ci`, Playwright — which load it explicitly.
#
# The 127.0.0.1 endpoints below are reachable only while
# `docker/compose.debug-ports.yml` is layered in (`pnpm infra:up:ports`); the
# default stack keeps the data services off the host.
#
# `pnpm env:init` copies this file to apps/api/.env when that file is missing.
# Generate production secrets independently, for example:
#   openssl rand -base64 48
# Never reuse these development values in production.

# ---- Application URLs and HTTP process ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
WS_URL=ws://localhost:3001
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT_BYTES=1048576

# ---- PostgreSQL / Drizzle ----
DATABASE_URL=postgres://notted:notted_dev_password@127.0.0.1:5432/notted_dev
DATABASE_POOL_MAX_CONNECTIONS=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_READINESS_TIMEOUT_MS=2500

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2500
REDIS_READINESS_TIMEOUT_MS=2500
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_RETRY_DELAY_MS=100
REDIS_RETRY_MAX_DELAY_MS=2000
REDIS_STARTUP_RETRY_ATTEMPTS=3

# ---- Authenticated Socket.io (shares API listener; no new port) ----
# Cookie clients require one exact trusted Origin. WebSocket-only transport is
# deliberate, so load-balancer polling stickiness is not required.
REALTIME_PATH=/socket.io
REALTIME_PING_INTERVAL_MS=30000
REALTIME_PING_TIMEOUT_MS=70000
REALTIME_REVALIDATION_INTERVAL_MS=25000
REALTIME_MAX_HTTP_BUFFER_BYTES=262144
REALTIME_MAX_ROOMS_PER_SOCKET=32
REALTIME_PREAUTH_ATTEMPTS_PER_MINUTE=30
REALTIME_AUTH_ATTEMPTS_PER_MINUTE=120
REALTIME_JOINS_PER_MINUTE=60
REALTIME_MAX_CONCURRENT_SOCKETS=8
# Collaborative editing (Part 58). Update and awareness frames are bounded well
# below REALTIME_MAX_HTTP_BUFFER_BYTES so an accepted frame is never one the
# transport would drop; boot fails if either ceiling reaches the buffer size.
# COLLABORATION_MAX_STATE_BYTES caps the durable Yjs state of a single note.
REALTIME_UPDATES_PER_MINUTE=900
REALTIME_AWARENESS_PER_MINUTE=900
REALTIME_MAX_UPDATE_BYTES=131072
REALTIME_MAX_AWARENESS_BYTES=8192
COLLABORATION_MAX_STATE_BYTES=4194304
# Presence (Part 59). A roster is ephemeral socket state, capped per room and
# never persisted: no table, no Redis key, nothing to restore after a restart.
REALTIME_MAX_PRESENCE_PER_ROOM=50
REALTIME_PRESENCE_ANNOUNCES_PER_MINUTE=30

# ---- Private MinIO object storage ----
# Values match the defaults in the root compose.yaml.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=nottedminio
MINIO_SECRET_KEY=notted-dev-minio-secret
MINIO_BUCKET_ATTACHMENTS=notted-attachments
MINIO_BUCKET_EXPORTS=notted-exports
MINIO_REGION=us-east-1
MINIO_READINESS_TIMEOUT_MS=2500
MINIO_STARTUP_RETRY_ATTEMPTS=3
MINIO_RETRY_DELAY_MS=100

# ---- Meilisearch ----
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=notted-dev-meili-master-key
MEILISEARCH_INDEX_PREFIX=notted_dev_
MEILISEARCH_REQUEST_TIMEOUT_MS=5000
MEILISEARCH_READINESS_TIMEOUT_MS=2500
MEILISEARCH_STARTUP_RETRY_ATTEMPTS=3
MEILISEARCH_RETRY_DELAY_MS=100
MEILISEARCH_TASK_TIMEOUT_MS=30000
MEILISEARCH_TASK_POLL_INTERVAL_MS=100

# ---- SMTP / Mailpit ----
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@notted.local
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=3000
EMAIL_SMTP_GREETING_TIMEOUT_MS=3000
EMAIL_SMTP_SOCKET_TIMEOUT_MS=5000
EMAIL_SMTP_READINESS_TIMEOUT_MS=2500
EMAIL_SMTP_STARTUP_RETRY_ATTEMPTS=3
EMAIL_SMTP_RETRY_DELAY_MS=100

# ---- Better Auth and server-side security ----
BETTER_AUTH_SECRET=notted-development-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=3600
AUTH_MAGIC_LINK_TOKEN_TTL_SECONDS=900
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# High-risk account changes require a session authenticated within this window.
AUTH_RECENT_AUTH_SECONDS=600
# WebAuthn allows HTTP only for localhost development. Production origins use HTTPS.
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_ORIGINS=http://localhost:3000
AUTH_TWO_FACTOR_CHALLENGE_SECONDS=600
AUTH_TWO_FACTOR_LOCKOUT_ATTEMPTS=10
AUTH_TWO_FACTOR_LOCKOUT_SECONDS=900
# OAuth providers are omitted unless their complete tuple is present. Never expose these
# server-only values through NEXT_PUBLIC_* variables, logs, screenshots, or documentation.
# AUTH_OAUTH_GOOGLE_CLIENT_ID=
# AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
# AUTH_OAUTH_GITHUB_CLIENT_ID=
# AUTH_OAUTH_GITHUB_CLIENT_SECRET=
# AUTH_OAUTH_MICROSOFT_CLIENT_ID=
# AUTH_OAUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_OAUTH_MICROSOFT_TENANT_ID=
# Better Auth 1.6.24 supports exactly 24 hours for non-remembered sessions.
SESSION_SHORT_LIVED_HOURS=24
# Explicit remember-me selection uses this server and cookie duration.
SESSION_REMEMBER_ME_DAYS=30
# Comma-separated version:base64 entries. The first version is active.
DATA_ENCRYPTION_KEYS=1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_WORKSPACE_STORAGE_BYTES=10737418240
SIGNED_URL_TTL_SECONDS=900

# ---- Storage quotas ----
# Default allowance per plan, applied when a workspace carries no explicit
# storage_limit_bytes override. MAX_WORKSPACE_STORAGE_BYTES above is an ABSOLUTE
# deployment ceiling: these values can only lower the effective limit, never
# raise it past that ceiling. That is why the enterprise default (100 GiB)
# resolves to 10 GiB until an operator deliberately raises the ceiling.
# Default 1 GiB.
STORAGE_QUOTA_FREE_BYTES=1073741824
# Default 10 GiB.
STORAGE_QUOTA_PRO_BYTES=10737418240
# Default 100 GiB.
STORAGE_QUOTA_ENTERPRISE_BYTES=107374182400

# ---- Storage maintenance sweeps ----
# Hours an attachment may sit in pending/processing before the sweep treats it
# as abandoned and returns its reserved bytes to the workspace quota. Default 24;
# uploads are synchronous and complete in seconds, so this is a wide margin.
STORAGE_ABANDONED_UPLOAD_HOURS=24
# MASTER SWITCH for the scheduled sweeps. DEFAULT false, deliberately: the
# sweeps hard-delete rows and object bytes, so nothing runs unattended until an
# operator has reviewed a dry-run report against this deployment's own data with
# `pnpm --filter @notted/api storage:report`.
STORAGE_MAINTENANCE_ENABLED=false
# The SAFE INTERMEDIATE STEP between the report and destructive sweeps: with
# STORAGE_MAINTENANCE_ENABLED=true and this set to true, the scheduler runs on
# its normal interval and logs what it WOULD do while deleting and modifying
# nothing. Watch those counts for several cycles before setting it to false.
# The code default is ALSO true, so flipping the master switch alone can never
# make a first run destructive — deleting bytes takes two explicit acts.
STORAGE_MAINTENANCE_DRY_RUN=true
# Milliseconds between scheduled sweep passes. Default 3600000 (one hour);
# accepted range is 60000 to 86400000.
STORAGE_MAINTENANCE_INTERVAL_MS=3600000
# Maximum rows any single sweep may act on in one pass. A safety bound rather
# than a performance knob: a mis-selecting sweep can affect at most this many
# rows before an operator sees the report. Default 200. A bounded pass reports
# itself as truncated and the next pass continues.
STORAGE_MAINTENANCE_BATCH_LIMIT=200
# Maximum object keys one bucket listing may buffer, so a very large bucket
# cannot be read into memory. Default 5000; the scan reports truncation instead.
STORAGE_MAINTENANCE_OBJECT_SCAN_LIMIT=5000

# ---- Retention windows consumed by the cleanup sweeps ----
# Values are in DAYS. The literal `unlimited` disables the automated purge for
# that plan entirely, which is the default for the paid tiers.
# Days a soft-deleted note stays recoverable in the trash before it is hard
# deleted along with its attachments. Free default 30.
RETENTION_DELETED_NOTE_DAYS_FREE=30
RETENTION_DELETED_NOTE_DAYS_PRO=unlimited
RETENTION_DELETED_NOTE_DAYS_ENTERPRISE=unlimited
# Days of note version history retained. Free default 30; paid tiers unlimited.
RETENTION_NOTE_VERSION_DAYS_FREE=30
RETENTION_NOTE_VERSION_DAYS_PRO=unlimited
RETENTION_NOTE_VERSION_DAYS_ENTERPRISE=unlimited
# Days audit_logs rows are kept. Default 365, uniform across plans because audit
# trails are compliance-relevant.
RETENTION_AUDIT_LOG_DAYS=365
# Days a completed export object stays downloadable before the sweep expires the
# row and deletes the bytes. Default 7.
RETENTION_EXPORT_OBJECT_DAYS=7
# Grace period before stored bytes that no live row claims are treated as
# orphaned, and before a terminally failed upload row is reclaimed. Default 7.
RETENTION_ORPHANED_OBJECT_DAYS=7

# ---- Rate limits ----
RATE_LIMIT_UNAUTHENTICATED_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=1000
RATE_LIMIT_SENSITIVE_PER_MINUTE=10

# ---- Feature flags ----
# Enabled dependencies participate in readiness and make /health/ready return
# HTTP 503 while down. Disabled dependencies report status "disabled".
FEATURE_REDIS_ENABLED=true
FEATURE_STORAGE_ENABLED=true
FEATURE_SEARCH_ENABLED=true
FEATURE_EMAIL_ENABLED=true
FEATURE_AI_ENABLED=false
FEATURE_REGISTRATION_ENABLED=true
FEATURE_REALTIME_ENABLED=true
# Collaborative editing rides the authenticated Socket.io transport, so
# enabling it while FEATURE_REALTIME_ENABLED=false fails configuration parsing.
# Unset, it FOLLOWS FEATURE_REALTIME_ENABLED: turning realtime off is already a
# decision to run without a socket transport, and it must not oblige every
# existing environment file to name a second key just to keep booting.
FEATURE_COLLABORATION_ENABLED=true

# ---- Canonical BullMQ execution queues (Part 50) ----
# PostgreSQL job_outbox is durable intent; Redis carries only the outbox UUID.
# Attempts default to 3. Backoff is exponential, capped, and jittered.
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=1000
QUEUE_BACKOFF_MAX_MS=60000
QUEUE_BACKOFF_JITTER_PERCENT=20
QUEUE_DISPATCH_INTERVAL_MS=1000
QUEUE_DISPATCH_BATCH_SIZE=100
# A crashed dispatch claim is recoverable after this window.
QUEUE_DISPATCH_STALE_CLAIM_MS=30000
# Per-process worker concurrency and hard execution bounds.
# High-priority jobs share this physical queue and use BullMQ priority.
QUEUE_DEFAULT_CONCURRENCY=8
QUEUE_DEFAULT_TIMEOUT_MS=60000
# Export concurrency is deliberately fixed at exactly two.
QUEUE_EXPORT_CONCURRENCY=2
QUEUE_EXPORT_TIMEOUT_MS=600000
QUEUE_AI_CONCURRENCY=4
QUEUE_AI_TIMEOUT_MS=120000
QUEUE_MAINTENANCE_CONCURRENCY=1
QUEUE_MAINTENANCE_TIMEOUT_MS=300000
# Provider-aware AI starts per-provider work within each rolling duration.
QUEUE_AI_OPENAI_RATE_MAX=5
QUEUE_AI_OPENAI_RATE_DURATION_MS=1000
QUEUE_AI_CLAUDE_RATE_MAX=5
QUEUE_AI_CLAUDE_RATE_DURATION_MS=1000
# PostgreSQL replay protection and bounded BullMQ operational history.
QUEUE_IDEMPOTENCY_RETENTION_DAYS=30
QUEUE_COMPLETED_RETENTION_SECONDS=86400
QUEUE_COMPLETED_RETENTION_COUNT=1000
QUEUE_FAILED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_COUNT=5000
QUEUE_SHUTDOWN_GRACE_MS=30000

# ---- Optional AI providers ----
# At least one provider key is required only when FEATURE_AI_ENABLED=true.
# AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
# AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-3-5-sonnet-latest

# ---- Export (Part 63) ----
# Absolute path to the Chromium binary used to render PDFs. Absent or empty
# disables PDF export; html and txt export keep working either way.
# EXPORT_CHROMIUM_PATH=/usr/bin/chromium
EXPORT_RENDER_TIMEOUT_MS=30000
EXPORT_MAX_ARTIFACT_BYTES=26214400
