{
  "name": "@notted/api",
  "version": "0.0.0",
  "private": true,
  "description": "Notted NestJS API application.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@notted/shared-types": "workspace:*",
    "@notted/shared-validators": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "compression": "1.8.1",
    "express": "4.22.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@types/compression": "1.8.1",
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
