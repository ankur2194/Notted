{
  "name": "@notted/api",
  "version": "0.0.0",
  "private": true,
  "description": "Notted NestJS API application.",
  "scripts": {
    "build": "tsc --build tsconfig.build.json --force",
    "dev": "node --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "env:validate": "tsx scripts/validate-env.ts",
    "storage:report": "node --env-file=.env --import tsx scripts/storage-report.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=.env --import tsx src/database/seed.ts",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.24",
    "@better-auth/passkey": "1.6.24",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@notted/shared-types": "workspace:*",
    "@notted/shared-validators": "workspace:*",
    "@trpc/server": "11.18.0",
    "better-auth": "1.6.24",
    "bullmq": "5.80.10",
    "busboy": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "compression": "1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "4.22.1",
    "heic-convert": "2.1.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "meilisearch": "0.60.0",
    "minio": "8.0.7",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@types/busboy": "1.5.4",
    "@types/compression": "1.8.1",
    "@types/express": "4.17.25",
    "@types/heic-convert": "2.1.1",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
