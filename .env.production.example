# Production environment for `compose.prod.yaml`. Copy to `.env.production`
# (gitignored), fill every REQUIRED value, then follow DEPLOYMENT.md.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Compose reads this file twice: for `${VAR}` substitution in compose.prod.yaml
# (`--env-file .env.production`) and as the API container's `env_file`. Any
# API variable from apps/api/.env.example can be added here. Values that
# compose.prod.yaml derives from the domains and secrets (APP_URL, API_URL,
# WS_URL, BETTER_AUTH_URL, BETTER_AUTH_TRUSTED_ORIGINS, DATABASE_URL,
# REDIS_URL, MINIO_*, MEILISEARCH_*) are set by the compose file, which takes
# precedence over this one, so setting them here has no effect.

# ---- Domains and ports (REQUIRED) ------------------------------------------
# Two hostnames served over HTTPS by the host's reverse proxy. The API refuses
# to start with non-HTTPS URLs in production, so TLS must terminate in front
# of the published ports. NEXT_PUBLIC_* URLs are derived from these and baked
# into the web image at build time — changing a domain means rebuilding `web`.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Host ports the proxy forwards to. Bound to NOTTED_BIND (loopback by default;
# set 0.0.0.0 only if the proxy runs on another machine).
NOTTED_WEB_PORT=3200
NOTTED_API_PORT=3201
NOTTED_BIND=127.0.0.1
# Reverse proxies between the browser and the API (host proxy = 1).
TRUST_PROXY_HOPS=1

# ---- Secrets (REQUIRED) — generate, never reuse dev values ----------------
# DEPLOYMENT.md §1.4 has a one-line command that fills every empty key below.
# Hex (not base64) for the five passwords: POSTGRES_PASSWORD and REDIS_PASSWORD
# end up inside connection URLs, where `/`, `+` and `=` break parsing.
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
REDIS_PASSWORD=
# openssl rand -hex 32   (>= 32 characters)
MEILI_MASTER_KEY=
# openssl rand -hex 32
MINIO_ROOT_PASSWORD=
# openssl rand -hex 32   (>= 32 characters)
BETTER_AUTH_SECRET=
# "1:" + openssl rand -base64 32   → e.g. 1:Qm9...=
DATA_ENCRYPTION_KEYS=

# ---- Email (REQUIRED) ------------------------------------------------------
# Production requires a user/password (>= 16 bytes) and TLS. The readiness
# probe (/health/ready) checks the SMTP server, so an unreachable host keeps
# `api` unhealthy. Email may only be disabled (FEATURE_EMAIL_ENABLED=false)
# together with FEATURE_REGISTRATION_ENABLED=false.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=Notted <noreply@example.com>

# ---- Optional -------------------------------------------------------------
# Names; defaults are fine.
POSTGRES_USER=notted
POSTGRES_DB=notted
MINIO_ROOT_USER=notted
MINIO_BUCKET_ATTACHMENTS=notted-attachments
MINIO_BUCKET_EXPORTS=notted-exports
MEILISEARCH_INDEX_PREFIX=notted_

# WebAuthn relying-party ID. Defaults to APP_DOMAIN; set to the registrable
# parent (example.com) only if passkeys must work across subdomains.
# AUTH_PASSKEY_RP_ID=

# Prometheus bearer for GET /metrics (>= 32 chars); unset keeps the route 404.
# openssl rand -hex 32
# METRICS_TOKEN=

LOG_LEVEL=info
# Disable public sign-up once the first workspace exists, if desired.
# FEATURE_REGISTRATION_ENABLED=false
# FEATURE_AI_ENABLED=false
# AI_OPENAI_API_KEY=

# Image tag used for notted-api / notted-web / notted-api-migrate. The deploy
# steps in DEPLOYMENT.md set this to the git SHA so rollback is a tag change.
NOTTED_IMAGE_TAG=local

# Memory limits (docker compose `deploy.resources.limits`).
API_MEMORY_LIMIT=2G
WEB_MEMORY_LIMIT=1G
POSTGRES_MEMORY_LIMIT=1G
MEILISEARCH_MEMORY_LIMIT=1G
REDIS_MAXMEMORY=256mb
