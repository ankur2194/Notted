# Local prompt-reference document
Agent-Prompt-Examples.md

# Dependencies
node_modules/
.pnpm-store/

# Compose overlays writable volumes at these tracked mount points. Keep only
# the placeholders; dependency contents remain ignored.
!node_modules/
node_modules/*
!node_modules/.docker-mount
!apps/api/node_modules/
apps/api/node_modules/*
!apps/api/node_modules/.docker-mount
!apps/web/node_modules/
apps/web/node_modules/*
!apps/web/node_modules/.docker-mount
!packages/shared-types/node_modules/
packages/shared-types/node_modules/*
!packages/shared-types/node_modules/.docker-mount
!packages/shared-validators/node_modules/
packages/shared-validators/node_modules/*
!packages/shared-validators/node_modules/.docker-mount

# Build outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Generated output is ignored except for mount points required by a clean
# Compose checkout before the read-only source bind is applied.
!apps/api/dist/
apps/api/dist/*
!apps/api/dist/.docker-mount
!apps/web/.next/
apps/web/.next/*
!apps/web/.next/.docker-mount
!packages/shared-types/dist/
packages/shared-types/dist/*
!packages/shared-types/dist/.docker-mount
!packages/shared-validators/dist/
packages/shared-validators/dist/*
!packages/shared-validators/dist/.docker-mount

# Turborepo
.turbo/

# Test coverage
coverage/
test-results/
playwright-report/

# Environment and secrets (example files are kept)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
Thumbs.db

# Local sync script
folder-sync.sh

# graphify query cache — a timestamp file rewritten on every query.
graphify-out/cache/
