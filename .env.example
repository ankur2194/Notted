# Optional overrides for the development stack in `compose.yaml`.
#
# Nothing here is required: every variable already has a default baked into
# `compose.yaml`, so `docker compose up` works on a fresh clone with no setup.
# Copy this file to `.env` (gitignored) only when you need to change something.
#
# `apps/api/.env` and `apps/web/.env.local` are a separate concern — they
# configure *host-side* tooling (`pnpm db:studio`, `pnpm test:ci`, Playwright)
# and are created by `pnpm env:init`. See `docs/environment.md`.

# ---- Published host ports (change one if it is already in use) ----
# Changing NOTTED_WEB_PORT or NOTTED_API_PORT also rewrites APP_URL, API_URL,
# WS_URL, the CORS allow-list and the NEXT_PUBLIC_* origins, so the browser and
# the API stay in agreement.
NOTTED_WEB_PORT=3000
NOTTED_API_PORT=3001
NOTTED_MAILPIT_WEB_PORT=8025

# ---- Ports published only by docker/compose.debug-ports.yml ----
NOTTED_POSTGRES_PORT=5432
NOTTED_REDIS_PORT=6379
NOTTED_MEILISEARCH_PORT=7700
NOTTED_MINIO_API_PORT=9000
NOTTED_MINIO_CONSOLE_PORT=9001
NOTTED_MAILPIT_SMTP_PORT=1025

# ---- PostgreSQL (pgvector) ----
# Automatic seeding accepts `notted_dev` and Notted-prefixed test/review names.
# Other non-production names require ALLOW_UNSAFE_DATABASE_SEED=true.
POSTGRES_USER=notted
POSTGRES_PASSWORD=notted_dev_password
POSTGRES_DB=notted_dev

# ---- Meilisearch ----
# The master key MUST be at least 16 bytes when set (Meilisearch v1.3+).
MEILI_MASTER_KEY=notted-dev-meili-master-key
MEILI_ENV=development

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=nottedminio
MINIO_ROOT_PASSWORD=notted-dev-minio-secret
MINIO_BUCKET_ATTACHMENTS=notted-attachments
MINIO_BUCKET_EXPORTS=notted-exports

# ---- API secrets (development placeholders) ----
BETTER_AUTH_SECRET=notted-development-auth-secret-change-me
DATA_ENCRYPTION_KEYS=1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
EMAIL_FROM=noreply@notted.local
